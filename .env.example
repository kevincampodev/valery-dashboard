# Copia este archivo como .env y llena los valores reales. El .env NUNCA se sube a GitHub.

# Clave que firma las sesiones. En producción, genera una con:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-esto

# Nombre de la empresa (aparece en los comprobantes y reportes)
EMPRESA_NOMBRE=Mi Empresa SAS

# Carpeta de backups (vacío = instance/backups). Ideal: una carpeta sincronizada con la nube
BACKUP_DIR=

# Base de datos (valery.db = la real, demo.db = datos de prueba)
DB_NAME=valery.db

# Entorno: "desarrollo" en tu PC, "produccion" en el servidor
ENTORNO=desarrollo

# 1 solo cuando la app corre con HTTPS (en el servidor). En tu PC, 0
COOKIES_SEGURAS=0